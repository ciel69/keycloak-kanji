{
  "realm": "KanjiFlow",
  "enabled": true,
  "loginTheme": "kanji-flow",
  "verifyEmail": true,
  "sslRequired": "external",
  "registrationAllowed": true,
  "registrationEmailAsUsername": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "bruteForceProtected": true,
  "permanentLockout": false,
  "maxFailureWaitSeconds": 900,
  "minimumQuickLoginWaitSeconds": 60,
  "failureFactor": 5,
  "defaultLocale": "ru",
  "internationalizationEnabled": true,
  "supportedLocales": ["ru", "en"],
  "defaultSignatureAlgorithm": "RS256",
  "revokeRefreshToken": false,
  "accessTokenLifespan": 300,
  "accessTokenLifespanForImplicitFlow": 900,
  "accessCodeLifespan": 60,
  "actionTokenGeneratedByUserLifespan": 300,
  "actionTokenGeneratedByAdminLifespan": 43200,
  "oauth2DeviceCodeLifespan": 600,
  "oauth2DevicePollingInterval": 5,
  "attributes": {
    "parRequestUriLifespan": "60"
  },
  "smtpServer": {
    "host": "${SMTP_HOST}",
    "port": "${SMTP_PORT}",
    "from": "${SMTP_FROM}",
    "fromDisplayName": "${SMTP_FROM_DISPLAY_NAME}",
    "user": "${SMTP_USER}",
    "password": "${SMTP_PASSWORD}",
    "starttls": "${SMTP_STARTTLS}",
    "auth": "${SMTP_AUTH}"
  },
  "clients": [
    {
      "clientId": "nuxt-web",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "authorizationServicesEnabled": false,
      "frontchannelLogout": true,
      "consentRequired": false,
      "redirectUris": [
        "https://kanji-flow.online/auth/callback",
        "http://localhost:3001/auth/callback"
      ],
      "webOrigins": ["+"],
      "protocol": "openid-connect",
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "frontchannel.logout.session.required": "true"
      }
    },
    {
      "clientId": "nest-api",
      "enabled": true,
      "publicClient": false,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "authorizationServicesEnabled": false,
      "frontchannelLogout": true,
      "consentRequired": false,
      "redirectUris": ["/*"],
      "webOrigins": ["/*"],
      "protocol": "openid-connect",
      "attributes": {
        "frontchannel.logout.session.required": "true"
      },
      "protocolMappers": [
        {
          "name": "realm roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "multivalued": "true",
            "userinfo.token.claim": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "realm_access.roles",
            "jsonType.label": "String"
          }
        }
      ]
    }
  ],
  "roles": {
    "realm": [
      {
        "name": "user",
        "description": "Default user role"
      },
      {
        "name": "admin-kanji",
        "description": "Administrator role"
      }
    ]
  },
  "groups": [
    {
      "name": "admin-kanji",
      "path": "/admin-kanji",
      "realmRoles": ["admin-kanji"]
    }
  ],
  "identityProviders": [
    {
      "alias": "telegram",
      "displayName": "Telegram",
      "providerId": "telegram",
      "enabled": true,
      "trustEmail": false,
      "storeToken": false,
      "addReadTokenRoleOnCreate": false,
      "firstBrokerLoginFlowAlias": "first broker login",
      "config": {
        "botId": "${TELEGRAM_BOT_ID}",
        "botToken": "${TELEGRAM_BOT_TOKEN}",
        "syncMode": "IMPORT"
      }
    }
  ],
  "identityProviderMappers": [
    {
      "name": "telegram-username",
      "identityProviderAlias": "telegram",
      "identityProviderMapper": "hardcoded-attribute-idp-mapper",
      "config": {
        "syncMode": "INHERIT",
        "attribute": "telegram_linked",
        "attribute.value": "true"
      }
    }
  ],
  "defaultRoles": ["user"],
  "users": [
    {
      "username": "service-account-nest-api",
      "enabled": true,
      "serviceAccountClientId": "nest-api",
      "clientRoles": {
        "realm-management": ["manage-users", "view-users", "query-users"]
      }
    }
  ]
}
