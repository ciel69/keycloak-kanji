# PostgreSQL Database
POSTGRES_PASSWORD=keycloak

# Keycloak Admin Credentials
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# Production Hostname (for HTTPS deployment)
KEYCLOAK_HOSTNAME=keycloak.kanji-flow.online

# SMTP (для писем верификации почты, сброса пароля и т.д.)
# ВАЖНО: контейнеру keycloak нужен исходящий доступ в интернет (egress)
# к указанному SMTP-хосту/порту, иначе рассылка писем не будет работать.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_FROM=noreply@kanji-flow.online
SMTP_FROM_DISPLAY_NAME=Kanji Flow
SMTP_USER=noreply@kanji-flow.online
SMTP_PASSWORD=changeme
SMTP_STARTTLS=true
SMTP_AUTH=true
