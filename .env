POSTGRES_PASSWORD=keycloak
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_HOSTNAME=auth.kanji-flow.online

# Telegram Identity Provider
TELEGRAM_BOT_ID=your_bot_id_here
TELEGRAM_BOT_TOKEN=your_bot_token_here

# SMTP - заполните реальными данными вашего почтового сервера
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_FROM=noreply@kanji-flow.online
SMTP_FROM_DISPLAY_NAME=Kanji Flow
SMTP_USER=noreply@kanji-flow.online
SMTP_PASSWORD=changeme
SMTP_STARTTLS=true
SMTP_AUTH=true
